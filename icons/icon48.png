<!DOCTYPE html>
<!-- saved from url=(0062)file:///E:/code%20things/sjbfsbu/create-placeholder-icons.html -->
<html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Extension Icons</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 800px;
            margin: 50px auto;
            padding: 20px;
            background: #0a0e27;
            color: white;
        }
        .icon-container {
            display: flex;
            gap: 20px;
            margin: 20px 0;
            flex-wrap: wrap;
        }
        canvas {
            border: 2px solid #06b6d4;
            border-radius: 8px;
        }
        button {
            background: linear-gradient(to right, #06b6d4, #a855f7);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            margin: 5px;
        }
        button:hover {
            opacity: 0.8;
        }
        .instructions {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
        }
    </style>
</head>
<body>
    <h1>🛡️ DetectShieldReview Icon Generator</h1>
    
    <div class="instructions">
        <h3>Instructions:</h3>
        <ol>
            <li>Click "Generate Icons" to create placeholder icons</li>
            <li>Right-click each icon and "Save image as..."</li>
            <li>Save them to <code>public/icons/</code> folder:
                <ul>
                    <li>icon16.png</li>
                    <li>icon48.png</li>
                    <li>icon128.png</li>
                </ul>
            </li>
            <li>Rebuild extension: <code>npm run build:extension</code></li>
        </ol>
    </div>

    <button onclick="generateIcons()">Generate Icons</button>
    
    <div class="icon-container" id="iconContainer"><div style="text-align: center;"><div><strong>16x16</strong></div><canvas width="16" height="16"></canvas><button>Download 16x16</button></div><div style="text-align: center;"><div><strong>48x48</strong></div><canvas width="48" height="48"></canvas><button>Download 48x48</button></div><div style="text-align: center;"><div><strong>128x128</strong></div><canvas width="128" height="128"></canvas><button>Download 128x128</button></div></div>

    <script>
        function generateIcons() {
            const sizes = [16, 48, 128];
            const container = document.getElementById('iconContainer');
            container.innerHTML = '';

            sizes.forEach(size => {
                const canvas = document.createElement('canvas');
                canvas.width = size;
                canvas.height = size;
                const ctx = canvas.getContext('2d');

                // Background gradient
                const gradient = ctx.createLinearGradient(0, 0, size, size);
                gradient.addColorStop(0, '#06b6d4');
                gradient.addColorStop(1, '#a855f7');
                ctx.fillStyle = gradient;
                ctx.fillRect(0, 0, size, size);

                // Shield shape
                ctx.fillStyle = 'white';
                ctx.beginPath();
                const centerX = size / 2;
                const centerY = size / 2;
                const shieldSize = size * 0.6;
                
                // Simple shield
                ctx.moveTo(centerX, centerY - shieldSize/2);
                ctx.lineTo(centerX + shieldSize/2, centerY - shieldSize/4);
                ctx.lineTo(centerX + shieldSize/2, centerY + shieldSize/4);
                ctx.lineTo(centerX, centerY + shieldSize/2);
                ctx.lineTo(centerX - shieldSize/2, centerY + shieldSize/4);
                ctx.lineTo(centerX - shieldSize/2, centerY - shieldSize/4);
                ctx.closePath();
                ctx.fill();

                // Add checkmark for larger icons
                if (size >= 48) {
                    ctx.strokeStyle = '#06b6d4';
                    ctx.lineWidth = size / 16;
                    ctx.lineCap = 'round';
                    ctx.beginPath();
                    ctx.moveTo(centerX - shieldSize/6, centerY);
                    ctx.lineTo(centerX - shieldSize/12, centerY + shieldSize/6);
                    ctx.lineTo(centerX + shieldSize/4, centerY - shieldSize/6);
                    ctx.stroke();
                }

                const wrapper = document.createElement('div');
                wrapper.style.textAlign = 'center';
                wrapper.innerHTML = `<div><strong>${size}x${size}</strong></div>`;
                wrapper.appendChild(canvas);
                
                const downloadBtn = document.createElement('button');
                downloadBtn.textContent = `Download ${size}x${size}`;
                downloadBtn.onclick = () => downloadIcon(canvas, size);
                wrapper.appendChild(downloadBtn);
                
                container.appendChild(wrapper);
            });
        }

        function downloadIcon(canvas, size) {
            const link = document.createElement('a');
            link.download = `icon${size}.png`;
            link.href = canvas.toDataURL();
            link.click();
        }

        // Auto-generate on load
        window.onload = generateIcons;
    </script>


</body></html>